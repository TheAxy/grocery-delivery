{
  "name": "grocery-delivery-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "shared"
  ],
  "scripts": {
    "build:host": "npm run build --workspace @grocery-delivery/host",
    "build:catalog-mf": "npm run build --workspace @grocery-delivery/catalog-mf",
    "build:account-mf": "npm run build --workspace @grocery-delivery/account-mf",
    "build:frontend": "npm run build:catalog-mf && npm run build:account-mf && npm run build:host"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
